# 服务
HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=http://localhost:8787
DATA_DIR=./server/data
DB_PATH=./server/data/time-theater.sqlite
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# AI：OpenAI 兼容接口。主用 OpenCode MiniMax，备用 AWKN MiniMax 直连（替换原百炼/DashScope）。
# 通用 AI_API_KEY 优先；AI_FALLBACK_* 为自动故障转移备援；DASHSCOPE_API_KEY 仅作百炼回退。
AI_BASE_URL=https://opencode.ai/zen/v1
AI_MODEL=deepseek-v4-flash-free
AI_API_KEY=
AI_FALLBACK_BASE_URL=https://api.minimaxi.com/v1
AI_FALLBACK_MODEL=MiniMax-M2.5
AI_FALLBACK_API_KEY=
DASHSCOPE_API_KEY=
AI_TIMEOUT_MS=30000
AI_ENABLED=true

# 初始管理员，仅供 npm run admin:seed 使用
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-seeding

# 运行开关
EVENT_TRACKING_ENABLED=true
WISH_POOL_ENABLED=true
ADMIN_DASHBOARD_ENABLED=true
