[Unit]
Description=Time Theater (时空剧场) Game Server
After=network.target

[Service]
Type=simple
WorkingDirectory=/srv/time-theater/current
# 注意：server/config.js 自带 loadDotEnv() 读取 ROOT_DIR/.env，
# 因此不要配 EnvironmentFile —— 冗余，且 systemd 会展开值里的 $ 导致密钥被破坏。
ExecStart=/usr/bin/node /srv/time-theater/current/server/start.js
Restart=on-failure
RestartSec=5
User=root
Environment=NODE_ENV=production

# --- 安全加固 ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/time-theater/data /srv/time-theater/logs

StandardOutput=append:/srv/time-theater/logs/app.log
StandardError=append:/srv/time-theater/logs/error.log
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

